{
  // «Run Code» (extensión Code Runner) arranca el Radar: app en :3000, simulador en :3001,
  // y abre el navegador. Funciona con cualquier archivo abierto del proyecto.
  "code-runner.runInTerminal": true,
  "code-runner.saveAllFilesBeforeRun": true,
  "code-runner.clearPreviousOutput": true,
  "code-runner.executorMap": {
    "javascript": "node \"$workspaceRoot/RadarEstacionamientos_code/iniciar.mjs\"",
    "javascriptreact": "node \"$workspaceRoot/RadarEstacionamientos_code/iniciar.mjs\"",
    "json": "node \"$workspaceRoot/RadarEstacionamientos_code/iniciar.mjs\"",
    "jsonc": "node \"$workspaceRoot/RadarEstacionamientos_code/iniciar.mjs\"",
    "css": "node \"$workspaceRoot/RadarEstacionamientos_code/iniciar.mjs\"",
    "markdown": "node \"$workspaceRoot/RadarEstacionamientos_code/iniciar.mjs\"",
    "plaintext": "node \"$workspaceRoot/RadarEstacionamientos_code/iniciar.mjs\""
  },
  "code-runner.defaultLanguage": "javascript",
  "files.exclude": { "**/.next": true, "**/node_modules": true, "**/.DS_Store": true },
  // Sin las letras de git (M, R, U…) junto a los archivos del explorador.
  "git.decorations.enabled": false,
  // Mapa de las HU (RadarEstacionamientos_code/docs/mapa_HU_codigo.md): la búsqueda no entra a
  // node_modules ni .next, y Todo Tree agrupa las etiquetas @HU-x.y por número de HU.
  "search.exclude": {
    "**/node_modules": true,
    "**/.next": true
  },
  "todo-tree.general.tags": [
    "@HU-1.1",
    "@HU-1.2",
    "@HU-1.3",
    "@HU-2.1",
    "@HU-2.2",
    "@HU-2.3",
    "@HU-2.4",
    "@HU-2.5",
    "@HU-3.1",
    "@HU-3.2",
    "@HU-3.3",
    "@HU-4.1",
    "@HU-4.2",
    "@HU-4.3",
    "@HU-4.4",
    "@HU-5.1",
    "@HU-5.2",
    "@HU-5.4",
    "@HU-5.5",
    "@HU-6.1",
    "@HU-6.2",
    "@HU-6.3",
    "@HU-7.1",
    "@HU-7.2",
    "@HU-7.3",
    "@HU-8.1",
    "@HU-8.2",
    "@HU-8.3",
    "@HU-9.1",
    "@HU-9.2",
    "@HU-9.3",
    "@HU-9.4",
    "@HU-10.2",
    "@HU-11.1",
    "@HU-11.4"
  ],
  "todo-tree.regex.regex": "(//|#|<!--|/\\*)\\s*($TAGS)(?=[\\s:]|$)",
  "todo-tree.tree.groupedByTag": true,
  "todo-tree.tree.showCountsInTree": true,
  "todo-tree.filtering.excludeGlobs": [
    "**/node_modules",
    "**/.next"
  ],
  "todo-tree.highlights.defaultHighlight": {
    "icon": "bookmark",
    "type": "tag",
    "foreground": "#ffffff",
    "background": "#0b4f8c"
  }
}
