        <mxCell id="logica" value="&lt;b&gt;Supracomponente: Lógica de negocio&lt;/b&gt;&lt;br&gt;[back/logica/]&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;&lt;b&gt;Responsabilidad:&lt;/b&gt; recibir cada petición, aplicar las reglas de negocio de las HU y las tácticas de seguridad y disponibilidad, y responder.&lt;br&gt;&lt;br&gt;&lt;b&gt;Contiene los componentes:&lt;/b&gt; controladores/ · dto/ · servicios/ · tacticas/ · modelos/&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#EAF1FB;strokeColor=#3C78D8;fontStyle=0;fontSize=13;spacing=14;" vertex="1" parent="1">
