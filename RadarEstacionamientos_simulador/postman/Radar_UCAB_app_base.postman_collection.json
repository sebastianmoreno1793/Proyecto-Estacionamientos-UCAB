{
  "info": {
    "name": "Radar UCAB · App base (como si fuera real)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Llamadas a la API pública de la app base (RadarEstacionamientos_code). Son las mismas que usan los sensores, el lector de placas de la garita, los usuarios y el simulador 3D. Si el simulador está abierto (http://localhost:3001), dibuja lo que mandes desde aquí (marcador rosa).\n\nVariables: urlBase, claveSensor (la de CLAVE_SENSORES; en desarrollo, clave-de-desarrollo) y estacionamiento (un id de data/estacionamientos.js)."
  },
  "variable": [
    {
      "key": "urlBase",
      "value": "http://localhost:3000"
    },
    {
      "key": "claveSensor",
      "value": "clave-de-desarrollo"
    },
    {
      "key": "estacionamiento",
      "value": "est-playa"
    }
  ],
  "item": [
    {
      "name": "Sensores y garita (HU 3.1, 3.2, 4.1)",
      "item": [
        {
          "name": "Aviso: entra un carro",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-clave-sensor",
                "value": "{{claveSensor}}"
              }
            ],
            "url": {
              "raw": "{{urlBase}}/api/avisos",
              "host": [
                "{{urlBase}}"
              ],
              "path": [
                "api",
                "avisos"
              ]
            },
            "description": "El sensor del estacionamiento ve entrar un carro. Baja un puesto libre. 409 si está lleno o desactivado. idAviso evita contar dos veces el mismo aviso.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estacionamientoId\": \"{{estacionamiento}}\",\n  \"tipo\": \"ENTRADA\",\n  \"idAviso\": \"{{$guid}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Aviso: sale un carro",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-clave-sensor",
                "value": "{{claveSensor}}"
              }
            ],
            "url": {
              "raw": "{{urlBase}}/api/avisos",
              "host": [
                "{{urlBase}}"
              ],
              "path": [
                "api",
                "avisos"
              ]
            },
            "description": "Sube un puesto libre. 409 si no hay carros dentro.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estacionamientoId\": \"{{estacionamiento}}\",\n  \"tipo\": \"SALIDA\",\n  \"idAviso\": \"{{$guid}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Lector de placas: entra a la garita",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-clave-sensor",
                "value": "{{claveSensor}}"
              }
            ],
            "url": {
              "raw": "{{urlBase}}/api/garita/lecturas",
              "host": [
                "{{urlBase}}"
              ],
              "path": [
                "api",
                "garita",
                "lecturas"
              ]
            },
            "description": "La placa queda registrada con la hora (solo la ve el personal autorizado en «Actividad de la garita»).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"placa\": \"AB123CD\",\n  \"sentido\": \"ENTRADA\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
