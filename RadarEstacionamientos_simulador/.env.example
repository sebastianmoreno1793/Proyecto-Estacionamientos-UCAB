# Copia este archivo como .env.local si la app base no está en http://localhost:3000
# o si cambiaste su clave de sensores. .env.local NO se sube al repo.

# Dónde corre la app base (RadarEstacionamientos_code).
URL_APP_BASE=http://localhost:3000

# La misma clave que CLAVE_SENSORES de la app base (encabezado x-clave-sensor).
CLAVE_SENSORES=clave-de-desarrollo

# Solo para el enlace "Abrir la app base" del simulador (lo ve el navegador).
NEXT_PUBLIC_URL_APP_BASE=http://localhost:3000
