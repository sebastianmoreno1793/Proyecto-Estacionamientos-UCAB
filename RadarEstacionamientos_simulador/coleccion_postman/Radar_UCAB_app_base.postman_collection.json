    {
      "name": "HU 7.2 · Sugerir el más cercano",
      "item": [
        {
          "name": "Sugerir el más cercano a un edificio",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{urlBase}}/api/sugerencia?edificio={{edificio}}",
              "host": [
                "{{urlBase}}"
              ],
              "path": [
                "api",
                "sugerencia"
              ],
              "query": [
                {
                  "key": "edificio",
                  "value": "{{edificio}}"
                }
              ]
            },
            "description": "HU 7.2. Devuelve el estacionamiento abierto con puestos libres más cercano al edificio (200). Es la misma llamada que hace la pantalla /sugerencia con fetch. Edificios: edif-aulas, edif-laboratorios, edif-cincuentenario, edif-postgrado, edif-centro-cultural, edif-aula-magna."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 con sugerido', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test('el sugerido tiene libres', () => pm.expect(r.sugerido.libres).to.be.above(0));",
                  "pm.test('ninguna alternativa está más cerca', () => r.alternativas.forEach(a => pm.expect(a.distancia).to.be.at.least(r.sugerido.distancia)));"
                ]
              }
            }
          ]
        },
