# Copia este archivo como .env.local y cambia los valores. .env.local NO se sube al repo.

# Clave que deben enviar los sensores, el lector de placas de la garita, el simulador y
# Postman en el encabezado x-clave-sensor (POST /api/avisos y POST /api/garita/lecturas).
# En desarrollo, si no la pones, vale "clave-de-desarrollo". En producción es obligatoria.
CLAVE_SENSORES=clave-de-desarrollo
